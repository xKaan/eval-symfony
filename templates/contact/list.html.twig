{% extends 'base.html.twig' %}

{% block title %}
  Demandes de contacts
{% endblock %}

{% block body %}
  <h1>Demandes de contacts</h1>

  <table>
      <thead>
      <tr>
          <th>Date</th>
          <th>Nom</th>
          <th>Prénom</th>
          <th>Sujet</th>
          <th>Message</th>
      </tr>
      </thead>
      <tbody>
      {% for contact in contacts %}
          <tr>
              <td>{{ contact.createdAt|date('d/m/Y') }}</td>
              <td>{{ contact.name }}</td>
              <td>{{ contact.firstname }}</td>
              <td>{{ contact.subject }}</td>
              <td>{{ contact.message }}</td>
          </tr>
      {% else %}
          <tr><td colspan="5">Aucune demande de contact</td></tr>
      {% endfor %}
      </tbody>
  </table>
{% endblock %}
